# DEVELOPMENT ONLY: wildcard origin. MUST be changed to explicit origins in production.
# Example production value: CLIENT_URL='https://gennia.online https://gennia.cn'
CLIENT_URL='*'
# CLIENT_URL='http://localhost:3000 http://127.0.0.1:3000 https://gennia.online https://gennia.cn'
PORT=3001
NODE_ENV=development

# for local development this to prisma directory in the .env file and run npx prisma studio
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=public"

# Required for every /admin endpoint. Use at least 32 random characters in production.
ADMIN_API_TOKEN="replace-with-a-long-random-admin-token"

# Optional UUID of an Event row. Matches are still recorded with a null event when omitted.
TOURNAMENT_EVENT_ID=""

# Azure Monitor Application Insights (server-side only).
APPLICATIONINSIGHTS_CONNECTION_STRING=""
APPLICATIONINSIGHTS_LIVE_METRICS=false
APPLICATIONINSIGHTS_SAMPLING_PERCENTAGE=100

# docker compose url
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/postgres?schema=public"

# explanation of DATABASE_URL
# DATABASE_URL=postgres://postgres:[passWord]@[db-url]:5432/[db-name]

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
PGADMIN_DEFAULT_EMAIL=pgadmin4@pgadmin.org
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=8555
