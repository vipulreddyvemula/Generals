# Local development defaults. Copy this file to server/.env.
# DEVELOPMENT ONLY: wildcard origin. MUST be changed to explicit origins in production.
# Example: CLIENT_URL='https://example.com https://www.example.com'
CLIENT_URL='*'
# CLIENT_URL='http://localhost:3000 http://127.0.0.1:3000'
PORT=3001
NODE_ENV=development

# Used when Prisma runs directly on the host laptop.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=public"

# Required for every /admin endpoint. Use at least 32 random characters in production.
ADMIN_API_TOKEN="replace-with-a-long-random-admin-token"

# Optional UUID of an Event row. Matches are still recorded with a null event when omitted.
TOURNAMENT_EVENT_ID=""

# Azure Monitor Application Insights (server-side only).
APPLICATIONINSIGHTS_CONNECTION_STRING=""
APPLICATIONINSIGHTS_LIVE_METRICS=false
APPLICATIONINSIGHTS_SAMPLING_PERCENTAGE=100

# Production-only replay storage. Leave blank locally. Authentication uses
# DefaultAzureCredential and the App Service managed identity; never add an
# account key here.
AZURE_STORAGE_ACCOUNT_NAME=""
AZURE_REPLAY_CONTAINER=""

# In-process allocation guards. These are safety ceilings, not load-test claims.
MAX_ROOMS=160
MAX_TOTAL_PLAYERS=300
MAX_PLAYERS_PER_ROOM=12

# Use this URL only when the server itself runs inside the Compose network.
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/postgres?schema=public"

# Local Docker Compose credentials. Do not reuse these in production.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
PGADMIN_DEFAULT_EMAIL=pgadmin4@pgadmin.org
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=8555
